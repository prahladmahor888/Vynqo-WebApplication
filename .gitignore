# ==========================================
# Environment & Secret Configuration
# ==========================================
.env
.env.backup
.env.production
.env.local
.env.*.local
*.key
auth.json
oauth-*.key

# ==========================================
# Dependencies & Package Managers
# ==========================================
/node_modules
/vendor
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Build Artifacts & Compiled Assets
# ==========================================
/public/build
/public/hot
/public/storage

# ==========================================
# Large Binary APK Files & Uploads
# ==========================================
/public/downloads/*.apk
!/public/downloads/.gitkeep

# ==========================================
# Laravel Framework Storage, Cache & Logs
# ==========================================
/storage/*.key
/storage/pail
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
*.log

# ==========================================
# Database & SQLite Caches
# ==========================================
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite-shm
database/*.sqlite-wal

# ==========================================
# Testing & Code Coverage
# ==========================================
.phpunit.cache
.phpunit.result.cache
/tests/coverage
.pest

# ==========================================
# IDEs, Editors & Operating System Metadata
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors & Tools
.fleet
.idea
.nova
.vscode
.zed
.cursor
.agents
.phpactor.json
Homestead.json
Homestead.yaml

# Temporary & Swap Files
*.tmp
*.bak
*.swp
*~
